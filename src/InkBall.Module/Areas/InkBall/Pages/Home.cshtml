@page
@inject Microsoft.Extensions.Options.IOptions<InkBallOptions> commonUIConfigureOptions
@model HomeModel
@{
    ViewData["Title"] = "ib:home.title";

    HtmlHelpers.RenderHeaderSection(this, Url, commonUIConfigureOptions);
}

<p class="h5 inkhome p-2 bg-info-subtle border border-success-subtle rounded-1"><span data-i18n='ib:home.welcome'>Welcome</span> <span>@Model.Player?.UserName</span></p>

<div class="alert alert-dismissible fade show inkhome" role="alert">
	<span></span>
	<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>

<div class="container inkhome" data-otherplayerid="@Model.ActiveGame?.GetOtherPlayer()?.iId">
	<div class="row" role="group" aria-label="Game menu">
		<form method='post' class="col-sm-12 col-md-4 order-last order-md-first btn-group-vertical p-1 was-validated">
		</form>
		<div class="col-sm-12 col-md-auto p-1">
			<video src="https://khdfgwsg62.ufs.sh/f/nEF5ACUOfURTm3f745MMvDKLr0VsFzW2aJAEyTQ4Z8XRuHSd" class="img-fluid rounded-1" style="object-fit: contain;" playsinline controls preload="metadata" aria-label="Game play video" title="Game play video"></video>
		</div>
	</div>
</div>

<script type='module'>
	import { HomeOnLoad } from "@Url.Content(Constants.WwwIncludeInkballJS)";

	HomeOnLoad(
		'@Model.Message',
		JSON.parse('@(Model.ActiveGame != null ? true : false)'.toLowerCase()),
		'@commonUIConfigureOptions.Value.LogoutPath',
		'@commonUIConfigureOptions.Value.LoginPath',
		'@commonUIConfigureOptions.Value.RegisterPath'
	)
</script>