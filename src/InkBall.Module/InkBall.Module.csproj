<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <!-- <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest> -->
    <LangVersion>latest</LangVersion>
    <Version>1.0.2.1</Version>
    <Configurations>Debug;Release;Oracle</Configurations>
    <!--<PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>-->
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>TRACE;INCLUDE_ORACLE;INCLUDE_SQLSERVER;INCLUDE_POSTGRES;INCLUDE_MYSQL</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Oracle|AnyCPU'">
    <DefineConstants>INCLUDE_ORACLE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>INCLUDE_MYSQL</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.2" />
    <PackageReference Include="Microsoft.Extensions.Identity.Stores" Version="9.0.2" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="9.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.2" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.3" Condition="$(DefineConstants.Contains('INCLUDE_POSTGRES'))" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0-preview.4.efcore.9.0.0.ci.20250223175444" Condition="$(DefineConstants.Contains('INCLUDE_MYSQL'))" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.2" Condition="$(DefineConstants.Contains('INCLUDE_SQLSERVER'))" />
    <PackageReference Include="Oracle.EntityFrameworkCore" Version="9.23.60" Condition="$(DefineConstants.Contains('INCLUDE_ORACLE'))" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="9.0.2" />
    <PackageReference Include="MessagePack" Version="3.1.3" />
  </ItemGroup>
<!--
  <ItemGroup Condition="'$(Configuration)'=='Debug'">
    <EmbeddedResource Include="wwwroot\css\*.css" />
    <EmbeddedResource Include="wwwroot\img\homescreen*" />
    <EmbeddedResource Include="wwwroot\js\*.js" />
    <EmbeddedResource Include="wwwroot\js\*.map" />
    <EmbeddedResource Include="wwwroot\css\*.map" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)'!='Debug'">
    <EmbeddedResource Include="wwwroot\css\*.css" />
    <EmbeddedResource Include="wwwroot\img\homescreen*" />
    <EmbeddedResource Include="wwwroot\js\*.js" />
    <EmbeddedResource Include="wwwroot\js\*.map" />
    <EmbeddedResource Include="wwwroot\css\*.map" />
  </ItemGroup>
-->
  <ItemGroup>
    <Content Include="IBwwwroot\css\*.css*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="IBwwwroot\img\homescreen.*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="IBwwwroot\js\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
